# Ollama local (default). For OpenAI: https://api.openai.com/v1, sk-..., gpt-model name
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:latest
CORS_ORIGIN=http://localhost:5173
# Neon Postgres (direct, non-pooled URL recommended for scripts.ingest)
NEON_DATABASE_URL=
# Ollama embedding model (768 dims). Another dimension needs EMBED_DIM in scripts/ingest.py + re-ingest.
EMBED_MODEL=nomic-embed-text
